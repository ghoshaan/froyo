{
  "manifest_version": 3,
  "name": "Froyo: Flight/Route Overlay",
  "version": "5.4.1",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.adsbexchange.com/*"],
      "js": ["adsb_bridge.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.html",
        "overlay.css",
        "aircraft_types.json",
        "adsb_hook.js",
        "aircraft_reg/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
